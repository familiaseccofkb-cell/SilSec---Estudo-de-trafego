# /etc/silsec/backup.env (permissão 600, dono root)
# Senha do repositório restic: gere com  openssl rand -base64 32 > /etc/silsec/restic.senha
# GUARDE UMA CÓPIA DESTA SENHA FORA DO SERVIDOR (cofre de senhas / papel no cofre). Sem ela o backup é irrecuperável.
export RESTIC_PASSWORD_FILE=/etc/silsec/restic.senha

# HD externo USB (montado em /mnt/backup-usb). Inicializar uma vez: restic -r /mnt/backup-usb/silsec init
export REPO_USB=/mnt/backup-usb/silsec

# Nuvem: Backblaze B2 (ou qualquer S3). Inicializar uma vez: restic -r "$REPO_NUVEM" init
export REPO_NUVEM=b2:nome-do-bucket:silsec
export B2_ACCOUNT_ID=
export B2_ACCOUNT_KEY=
