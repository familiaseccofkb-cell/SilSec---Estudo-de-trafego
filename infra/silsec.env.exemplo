# Copie para /etc/silsec/silsec.env (permissão 600, dono root) e ajuste.

# E-mail do proprietário: esta conta vira administradora do sistema no primeiro acesso.
SILSEC_OWNER_EMAIL=seu-email@exemplo.com.br

# Endereços pelos quais o sistema será acessado (sem barra no final), separados por vírgula.
# Qualquer outro endereço é recusado (proteção contra DNS rebinding).
#  - modo A (DDNS direto):     https://silsec.seudominio.com.br
#  - modo B (relé em nuvem):   https://silsec.seudominio.com.br
#  - rede local, sem internet: https://silsec.lan
SILSEC_PUBLIC_ORIGINS=https://silsec.seudominio.com.br,https://silsec.lan

# O Node escuta somente em endereços internos; o Caddy (HTTPS) fica na frente.
# No modo B, acrescente o IP do túnel WireGuard: 127.0.0.1,10.66.0.2
SILSEC_HOST=127.0.0.1
SILSEC_PORT=8080
SILSEC_TRUST_PROXY=true

SILSEC_DATA_DIR=/var/lib/silsec
SILSEC_BACKUP_DIR=/var/lib/silsec/backups
SILSEC_BACKUP_KEEP=14
SILSEC_APP_DIR=/opt/silsec/sistema-original

# Sessão: renovada a cada uso (horas) até o limite absoluto (dias).
SILSEC_SESSION_HOURS=12
SILSEC_SESSION_MAX_DAYS=30

# Leitura automática de notas fiscais/contratos por IA envia documentos a um serviço externo.
# Mantenha "false" para que nenhum dado saia do servidor local.
SILSEC_ENABLE_EXTERNAL_AI=false
# OPENAI_API_KEY=
